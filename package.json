{
  "name": "byorderkasir",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "POS + self-order untuk kafe & resto — ringan, realtime, satu basis kode untuk 4 surface",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"src/**/*.test.ts\"",
    "realtime": "node tools/realtime-server.mjs",
    "check": "npm run typecheck && npm run test",
    "db:parse": "npm --prefix supabase/uji run parse",
    "db:siapkan": "npm --prefix supabase/uji run siapkan",
    "db:jalan": "npm --prefix supabase/uji run jalan",
    "db:uji": "npm --prefix supabase/uji run uji"
  },
  "dependencies": {
    "@fontsource-variable/playfair-display": "^5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@preact/signals": "^2.0.1",
    "@supabase/supabase-js": "^2.45.4",
    "preact": "^10.24.3",
    "uqr": "^0.1.3"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.9.1",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^26.6.3",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.6.3",
    "vite": "^6.0.0"
  }
}
